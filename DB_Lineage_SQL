%sql
select 
  a.target_table_schema as `BTL Schema`,
  a.target_table_name as `BTL View`,
  a.target_column_name as `BTL Column`,
  concat(b.target_table_schema, '.', b.target_table_name) as `Table Level 2`,
  b.source_column_name as `Column Level 2`,
  concat(c.target_table_schema, '.', c.target_table_name) as `Table Level 3`,
  c.source_column_name as `Column Level 3`,
  concat(d.target_table_schema, '.', d.target_table_name) as `Table Level 4`,
  d.source_column_name as `Column Level 4`,
  concat(e.target_table_schema, '.', e.target_table_name) as `Table Level 5`,
  e.source_column_name as `Column Level 5`
from (
  select
    target_table_schema,
    target_table_name,
    target_column_name,
    source_table_full_name,
    source_column_name,
    target_table_full_name
  from system.access.column_lineage
  where target_table_catalog in ('axiom_btl_prd_lpl', 'axiom_btl_prd_spl')
    and target_table_schema not like '%build%'
    and target_table_schema not in ('data_governance', 'dw_btl_stg_claim', 'btl_platform_optimization','dw_btl_platform_optimization')
    and account_id = 'cd4f7516-5ca9-413f-a0c9-b8fc41869d9c' and metastore_id = '31618468-ec94-43d2-bca1-5af17e52f257'
) a
left join system.access.column_lineage b
  on a.source_table_full_name = b.target_table_full_name
  and a.source_column_name = b.target_column_name 
left join system.access.column_lineage c
  on b.source_table_full_name = c.target_table_full_name
  and b.source_column_name = c.target_column_name 
  
left join system.access.column_lineage d
  on c.source_table_full_name = d.target_table_full_name
  and c.source_column_name = d.target_column_name
 
left join system.access.column_lineage e
  on d.source_table_full_name = e.target_table_full_name
  and d.source_column_name = e.target_column_name
  group by all 
order by 1,2,3
