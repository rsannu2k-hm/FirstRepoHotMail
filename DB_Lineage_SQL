# --- Configuration ---
start_catalog = "xliidw_prd_lpl"
start_schema  = "staging_wins"
start_table   = "t_wins_dwxc010_full"
n_levels      = 3  # Number of downstream levels to trace
catalog_filter = "('xliidw_prd_lpl','xliidw_prd_spl')"  # Restrict target catalogs
 
# --- Iterative N-level downstream lineage ---
from pyspark.sql import functions as F
from functools import reduce
 
all_results = []
current_level_df = spark.sql(f"""
    SELECT DISTINCT
        target_table_catalog  AS catalog_name,
        target_table_schema   AS schema_name,
        target_table_name     AS table_name
    FROM system.access.table_lineage
    WHERE source_table_catalog = '{start_catalog}'
      AND source_table_schema  = '{start_schema}'
      AND source_table_name    = '{start_table}'
      AND target_table_catalog in {catalog_filter}
""")
 
for level in range(1, n_levels + 1):
    current_level_df = current_level_df.withColumn("level", F.lit(level))
    row_count = current_level_df.count()
    if row_count == 0:
        print(f"Level {level}: No further downstream tables found. Stopping.")
        break
    print(f"Level {level}: Found {row_count} downstream table(s)")
    all_results.append(current_level_df)
 
    # Collect current level tables to use as next source
    current_tables = current_level_df.select("catalog_name", "schema_name", "table_name").distinct()
    current_tables.createOrReplaceTempView("current_sources")
 
    current_level_df = spark.sql(f"""
        SELECT DISTINCT
            tl.target_table_catalog AS catalog_name,
            tl.target_table_schema  AS schema_name,
            tl.target_table_name    AS table_name
        FROM system.access.table_lineage tl
        INNER JOIN current_sources cs
            ON tl.source_table_catalog = cs.catalog_name
           AND tl.source_table_schema  = cs.schema_name
           AND tl.source_table_name    = cs.table_name
        WHERE tl.target_table_catalog IN {catalog_filter}
    """)
 
if all_results:
    result_df = reduce(lambda a, b: a.unionAll(b), all_results).distinct()
    result_df = result_df.orderBy("level", "catalog_name", "schema_name", "table_name")
    display(result_df)
else:
    print("No downstream lineage found.")
---=============================================================================
WITH lineage_enriched AS (
SELECT
    tl.*,
    COALESCE(
    tl.source_table_full_name,
    CONCAT(src.table_catalog, '.', src.table_schema, '.', src.table_name)
) AS resolved_source_table,
COALESCE(
    tl.target_table_full_name,
    CONCAT(tgt.table_catalog, '.', tgt.table_schema, '.', tgt.table_name)
) AS resolved_target_table
FROM system.access.table_lineage tl
LEFT JOIN system.information_schema.tables src
       ON tl.source_path = src.storage_path
LEFT JOIN system.information_schema.tables tgt
       ON tl.target_path = tgt.storage_path
)

SELECT
    resolved_source_table AS source_table,
    resolved_target_table AS target_table,
    *
FROM lineage_enriched
WHERE resolved_source_table = '<CATALOG>.<SCHEMA>.<TABLE>'
OR resolved_target_table = '<CATALOG>.<SCHEMA>.<TABLE>';
