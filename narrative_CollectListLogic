WITH max_line_number as (
    select PKStatsLedgerSeq, max(LineNumber)   as max_linenumber
    FROM {{ source("db_source_lpl", "oz_gen_narratives") }}
    WHERE PKStatsLedgerSeq != 0 AND PKStatsLedgerSeq IS NOT NULL
    group by PKStatsLedgerSeq
),
 
final AS (
    SELECT
        PKStatsLedgerSeq,
        LineNumber,
    collect_list(NarrativeDesc) OVER (partition by PKStatsLedgerSeq
        ORDER BY LineNumber  
        ROWS BETWEEN 9 PRECEDING AND CURRENT ROW
    ) as NarrativeDesc
    FROM {{ source("db_source_lpl", "oz_gen_narratives") }}
    WHERE PKStatsLedgerSeq != 0 AND PKStatsLedgerSeq IS NOT NULL
    ORDER BY  LineNumber ASC
)
select
final.PKStatsLedgerSeq,
 concat_ws(' ' , final.NarrativeDesc) as NarrativeDesc
 from
 final 
inner join max_line_number
on final.pkstatsledgerseq = max_line_number.PKStatsLedgerSeq
and final.LineNumber = max_line_number.max_linenumber
 

